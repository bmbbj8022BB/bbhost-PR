msgstr "십자키 아래. 퀵 아이템을 순서대로 바꿉니다."

msgid "Switch Right Weapon"
msgstr "오른손 무기 전환"

msgid "D-pad right."
msgstr "십자키 오른쪽."

msgid "Switch Left Weapon"
msgstr "왼손 무기 전환"

msgid "D-pad left."
msgstr "십자키 왼쪽."

msgid "D-pad Up"
msgstr "십자키 위"

msgid "D-pad up."
msgstr "십자키 위."

msgid "Gestures"
msgstr "제스처"

msgid "The touchpad's left side."
msgstr "터치패드의 왼쪽 면."

msgid "Personal Effects"
msgstr "개인 소지품"

msgid "The touchpad's right side."
msgstr "터치패드의 오른쪽 면."

msgid "Look Up"
msgstr "위로 보기"

msgid "Right stick up, for the camera without the mouse."
msgstr "오른쪽 스틱 위. 마우스 없이 카메라를 움직일 때 씁니다."

msgid "Look Down"
msgstr "아래로 보기"

msgid "Right stick down."
msgstr "오른쪽 스틱 아래."

msgid "Look Left"
msgstr "왼쪽으로 보기"

msgid "Right stick left."
msgstr "오른쪽 스틱 왼쪽."

msgid "Look Right"
msgstr "오른쪽으로 보기"

msgid "Right stick right."
msgstr "오른쪽 스틱 오른쪽."

msgid "Options. Open the menu."
msgstr "옵션. 메뉴를 엽니다."

msgid "Menu Confirm"
msgstr "메뉴 확인"

msgid "OK, in menus."
msgstr "메뉴에서의 확인."

msgid "Menu Back"
msgstr "메뉴 뒤로"

msgid "Return, in menus."
msgstr "메뉴에서의 뒤로 가기."

msgid "Menu Previous Page"
msgstr "메뉴 이전 페이지"

msgid "L1 in menus: the previous page, tab or category."
msgstr "메뉴에서의 L1: 이전 페이지, 탭, 분류."

msgid "Menu Next Page"
msgstr "메뉴 다음 페이지"

msgid "R1 in menus: the next page, tab or category."
msgstr "메뉴에서의 R1: 다음 페이지, 탭, 분류."

msgid "Menu Shortcut (L2)"
msgstr "메뉴 단축키 (L2)"

msgid "L2 in menus: the storage box's Show Storage, the rankings' top."
msgstr "메뉴에서의 L2: 보관함의 보관함 보기, 랭킹의 맨 위."

msgid "Menu Shortcut (R2)"
msgstr "메뉴 단축키 (R2)"

msgid "R2 in menus: the storage box's Show Storage, your own grades."
msgstr "메뉴에서의 R2: 보관함의 보관함 보기, 내 순위."

msgid "Menu Toggle Display"
msgstr "메뉴 표시 전환"

msgid "Square in menus: Toggle Display, Unequip, Remove, Delete."
msgstr "메뉴에서의 네모: 표시 전환, 장비 해제, 제거, 삭제."

msgid "Menu Toggle Status"
msgstr "메뉴 상태 전환"

msgid "Triangle in menus: Toggle Status, Switch, Initialize."
msgstr "메뉴에서의 세모: 상태 전환, 교체, 초기화."

msgid "Left Stick Press"
msgstr "왼쪽 스틱 누르기"

msgid "Camera Zoom In"
msgstr "카메라 확대"

msgid "Brings the camera a step closer."
msgstr "카메라를 한 단계 가깝게 가져옵니다."

msgid "Camera Zoom Out"
msgstr "카메라 축소"

msgid "Takes the camera a step further out."
msgstr "카메라를 한 단계 멀리 보냅니다."

msgid "Camera Zoom Reset"
msgstr "카메라 줌 초기화"

msgid "The camera back to the game's own distance."
msgstr "카메라를 게임 기본 거리로 되돌립니다."

msgid "Opens and closes the developers' debug menu (the Debug Menu plugin)."
msgstr "개발자 디버그 메뉴를 열고 닫습니다(디버그 메뉴 플러그인)."

msgid "Original"
msgstr "기본"

msgid "Disable Camera Auto Rotation"
msgstr "카메라 자동 회전 끄기"

msgid "Auto"
msgstr "자동"

msgid "Keyboard"
msgstr "키보드"

msgid "Controller"
msgstr "컨트롤러"

