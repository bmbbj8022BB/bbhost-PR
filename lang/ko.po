msgstr "1.09 eboot이 아닙니다 (SHA-256 %s...)"

msgid "Data folder (saves and caches; empty for the default)"
msgstr "데이터 폴더 (세이브와 캐시; 비워 두면 기본값)"

msgid "has dvdroot_ps4"
msgstr "dvdroot_ps4가 있습니다"

msgid "not set"
