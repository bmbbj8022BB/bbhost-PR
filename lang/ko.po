msgstr "마지막 컴파일"

msgid "The last compile"
msgstr "마지막 컴파일"

msgid "%llu of %llu, %llu failed"
msgstr "%llu / %llu개, 실패 %llu개"

msgid "%llu with DXC's module (%llu compiled now), %llu kept the lift"
msgstr "DXC 모듈 사용 %llu개(이번에 컴파일 %llu개), lift 유지 %llu개"

