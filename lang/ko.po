msgstr "bbhost를 시작할 때마다 이 창 표시"

msgid "Or start bbhost with --setup to open it once."
msgstr "또는 --setup으로 bbhost를 시작하면 한 번 열립니다."

msgid "Play waits for the compile (Shaders tab)."
msgstr "컴파일이 끝날 때까지 플레이를 기다립니다 (셰이더 탭)."

msgid "Play needs the game folder and the 1.09 eboot."
msgstr "플레이하려면 게임 폴더와 1.09 eboot이 필요합니다."

msgid "  (next start)"
msgstr "  (다음 시작부터)"

msgid "Random seed"
msgstr "무작위 시드"

msgid "(turn the plugin on and restart)"
msgstr "(플러그인을 켜고 다시 시작하세요)"

msgid "(in the game: the plugin menu)"
msgstr "(게임 안: 플러그인 메뉴)"

msgid "Get the latest official plugins"
msgstr "최신 공식 플러그인 받기"

msgid "Rescan"
msgstr "다시 검색"

msgid "Show plugin settings at every start"
msgstr "시작할 때마다 플러그인 설정 표시"

msgid "No plugins. Get the official ones above, or put plugin files in %s/plugins."
msgstr "플러그인이 없습니다. 위에서 공식 플러그인을 받거나, 플러그인 파일을 %s/plugins에 넣으세요."

msgid "  (off)"
msgstr "  (꺼짐)"

msgid "by %s - %s"
msgstr "제작: %s - %s"

