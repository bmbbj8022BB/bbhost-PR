+    g_img_stage = VK_NULL_HANDLE;
+    g_img_stage_mem = VK_NULL_HANDLE;
+    g_img_view = VK_NULL_HANDLE;
+    g_img = VK_NULL_HANDLE;
+    g_img_mem = VK_NULL_HANDLE;
+    g_img_pipeline = VK_NULL_HANDLE;
