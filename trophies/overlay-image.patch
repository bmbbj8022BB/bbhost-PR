+        if (!g_img_dirty) return;
+        w = g_img_pending_w;
+        h = g_img_pending_h;
+        if (w == 0 || h == 0 || g_img_pending.size() < static_cast<std::size_t>(w) * h * 4) {
+            g_img_dirty = false;
